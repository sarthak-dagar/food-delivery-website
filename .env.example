# No MongoDB needed - this app uses SQLite (file based, backend/data/fooddelivery.db)

# Optional. If not set, a random one is generated at startup.
# e.g. generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Render supplies PORT automatically; leave blank for local run (defaults to 5000)
PORT=
