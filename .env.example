# No MongoDB needed - this app uses SQLite

# Optional. If not set, a random one is generated at startup.
# e.g. generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Render supplies PORT automatically; leave blank for local run (defaults to 5000)
PORT=

# Turso (cloud SQLite) - free tier. Data stays saved on Render redeploys.
# Local run ke liye ye 2 chhodo - app local SQLite use karegi.
# Setup: https://turso.tech -> signup -> create database -> token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
